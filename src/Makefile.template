CC = <CC>

INCLUDE_FLAGS = -I<HDF5_INCLUDE_DIR> -I<HDF4_INCLUDE_DIR> -I<NETCDF_INCLUDE_DIR> -I<LIBCONFIG_INCLUDE_DIR> -I<ZLIB_INCLUDE_DIR> -I<JPEG_INCLUDE_DIR>

LDFLAGS = -L<HDF5_LIB_DIR> -L<HDF4_LIB_DIR> -L<ZLIB_LIB_DIR> -L<JPEG_LIB_DIR> -L<NETCDF_LIB_DIR> -L<LIBCONFIG_LIB_DIR> <HDF4_LIB_FLAGS> <HDF5_LIB_FLAGS> <LIBCONFIG_LIB_FLAGS> <NETCDF_LIB_FLAGS> <CC_LD_OPTS>

CFLAGS = <CFLAGS> $(INCLUDE_FLAGS)

OBJS = baseTypes.o configuration.o cubeShellInit.o cubeShellStruct.o energeticParticlesBoundary.o energeticParticles.o energeticParticlesInit.o energeticParticlesTypes.o eprem.o error.o flow.o geometry.o global.o masInterp.o masIO.o mpiInit.o nearestGridNode.o observerOutput.o readMAS.o search.o simCore.o unifiedOutput.o

all: $(OBJS)
	$(CC) $(CFLAGS) $(INCLUDE_FLAGS) $(OBJS) $(LDFLAGS) -o eprem
	rm -f *.o 2>/dev/null

clean:
	rm -f eprem 2>/dev/null
	rm -f *.o 2>/dev/null

install:
	cp eprem ../bin/

baseTypes = baseTypes.h baseTypes.c

configuration = configuration.h configuration.c cubeShellStruct.h cubeShellStruct.c error.h error.c global.h global.c mpiInit.h mpiInit.c

